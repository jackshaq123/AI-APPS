# Copy to .env (never commit .env). All values below are examples.
SECRET_KEY=generate-a-long-random-string
BASE_URL=https://www.yourdomain.com
BRAND_NAME=PassPrep
SUPPORT_EMAIL=support@yourdomain.com
BUSINESS_ADDRESS=
DATABASE_URL=sqlite:///examprep.db
DEFAULT_EXAM=us-citizenship-2025
# Turn off once the real question pack is in place:
SHOW_DEMO_PACKS=true
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Card statements show "<account name>* <suffix>", e.g. PASSPREP
STATEMENT_DESCRIPTOR_SUFFIX=PASSPREP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@yourdomain.com
SMTP_PASSWORD=app-password
MAIL_FROM=PassPrep <support@yourdomain.com>
META_PIXEL_ID=
